# ---------------------------------------------------------------------------
# Copy this file to ".env" (same folder) and fill in your values.
#   Windows (cmd):  copy .env.example .env
# Never commit the real .env file.
# ---------------------------------------------------------------------------

# ----- Backend (Express API) -----
PORT=5000
NODE_ENV=development
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGIN=http://localhost:5173
# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Set to true to let the API also serve the built frontend (single-server deployment)
SERVE_FRONTEND=false

# ----- MySQL (primary database) -----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=result_portal
# Cloud databases usually require TLS:
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# ----- MongoDB (OPTIONAL: report-card snapshots) -----
# Leave MONGODB_URI empty to disable the snapshot feature. Everything else still works.
# Local:  mongodb://127.0.0.1:27017        Atlas: mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URI=
MONGODB_DB=result_portal

# ----- Frontend (Vite) -----
# Base URL of the API as seen from the browser.
#   Development: leave as /api (Vite proxies it to the backend)
#   Production : e.g. https://api.your-domain.com/api
VITE_API_URL=/api
# Where the Vite dev server forwards /api calls (development only)
VITE_DEV_PROXY_TARGET=http://localhost:5000
